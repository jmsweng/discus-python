# Correlated-disorder model: 4x4x4 checkerboard (256 sites, 128 Ga, 128 As)
# Supercell: 20.0 A x 20.0 A x 20.0 A
# Expected PDF peaks at ±2.5 A along x, y, z
discus
read
  stru corr_model.stru
fourier
  xray
  wvle moa1
  ll -2.0,-2.0,-2.0
  lr  2.0,-2.0,-2.0
  ul -2.0, 2.0,-2.0
  tl -2.0,-2.0, 2.0
  na 33
  no 33
  nt 33
  abs h
  ord k
  top l
  temp use
  disp off
  lots off
  set technique:turbo
  set aver,0.0
  show
  run
exit
output
  value int
  form nexus
  outf corr_total.h5
  run
  value 3DPDF
  form nexus
  outf corr_total_3dpdf.h5
  run
exit
exit
exit
