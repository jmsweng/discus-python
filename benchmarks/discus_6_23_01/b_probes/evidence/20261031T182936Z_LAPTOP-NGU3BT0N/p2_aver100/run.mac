fourier
  xray
  wvle moa1
  ll -2,-2,-2
  lr 1.875,-2,-2
  ul -2,1.875,-2
  tl -2,-2,1.875
  na 32
  no 32
  nt 32
  abs h
  ord k
  top l
  temp ignore
  disp off
  lots off
  set technique:turbo
  set aver,100.0
  show
  run
exit
output
