# B probe p5_default: odd grid, set aver 100, default symm (generated by make_macros.py; do not edit)
discus
read
  stru gate2_block.stru
eval n[1]
eval n[2]
eval n[3]
fourier
  xray
  wvle moa1
  ll -2,-2,-2
  lr 2,-2,-2
  ul -2,2,-2
  tl -2,-2,2
  na 33
  no 33
  nt 33
  abs h
  ord k
  top l
  temp ignore
  disp off
  lots off
  set technique:turbo
  set aver,100.0
  show
  run
exit
output
  value int
  form nexus
  outf p5_default_int.h5
  run
exit
exit
exit
