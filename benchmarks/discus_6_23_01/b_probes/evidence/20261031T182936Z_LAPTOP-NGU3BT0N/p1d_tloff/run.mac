# B probe p1d_tloff: hk0 plane, nt=1 but tl != ll (generated by make_macros.py; do not edit)
discus
read
  cell gaas.cll,4,4,4
eval n[1]
eval n[2]
eval n[3]
fourier
  xray
  wvle moa1
  ll -2,-2,0
  lr 2,-2,0
  ul -2,2,0
  tl -2,-2,1
  na 41
  no 41
  nt 1
  abs h
  ord k
  top l
  temp ignore
  disp off
  lots off
  set technique:turbo
  set aver,0.0
  show
  run
exit
output
  value int
  form nexus
  outf p1d_tloff_int.h5
  run
exit
exit
exit
