# B probe p2_aver50_s1b: set aver 50, single-value seed again (generated by make_macros.py; do not edit)
discus
seed 1234
read
  stru gate2_random.stru
eval n[1]
eval n[2]
eval n[3]
fourier
  xray
  wvle moa1
  ll -2,-2,-2
  lr 1.875,-2,-2
  ul -2,1.875,-2
  tl -2,-2,1.875
  na 32
  no 32
  nt 32
  abs h
  ord k
  top l
  temp ignore
  disp off
  lots off
  set technique:turbo
  set aver,50.0
  show
  run
exit
output
  value int
  form nexus
  outf p2_aver50_s1b_int.h5
  run
exit
exit
exit
