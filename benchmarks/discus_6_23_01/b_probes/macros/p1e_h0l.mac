# B probe p1e_h0l: h0l plane, middle axis inactive (no=1) (generated by make_macros.py; do not edit)
discus
read
  cell gaas.cll,4,4,4
eval n[1]
eval n[2]
eval n[3]
fourier
  xray
  wvle moa1
  ll -2,0,-2
  lr 2,0,-2
  ul -2,0,-2
  tl -2,0,2
  na 41
  no 1
  nt 41
  abs h
  ord k
  top l
  temp ignore
  disp off
  lots off
  set technique:turbo
  set aver,0.0
  show
  run
exit
output
  value int
  form nexus
  outf p1e_h0l_int.h5
  run
exit
exit
exit
