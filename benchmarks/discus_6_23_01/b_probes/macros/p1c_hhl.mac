# B probe p1c_hhl: oblique hhl plane, nt=1 (generated by make_macros.py; do not edit)
discus
read
  cell gaas.cll,4,4,4
eval n[1]
eval n[2]
eval n[3]
fourier
  xray
  wvle moa1
  ll -2,-2,-2
  lr 2,2,-2
  ul -2,-2,2
  tl -2,-2,-2
  na 41
  no 41
  nt 1
  abs h
  ord k
  top l
  temp ignore
  disp off
  lots off
  set technique:turbo
  set aver,0.0
  show
  run
exit
output
  value int
  form nexus
  outf p1c_hhl_int.h5
  run
exit
exit
exit
