discus
read
  stru occ_bcc.stru
chem
set mode, quick, period
set vec, 1, 1, 2, 0, 0, 0
set vec, 2, 1, 2, -1, -1, -1
set vec, 3, 1, 1, 1, 0, 0
set vec, 4, 2, 2, 0, 1, 0
set vec, 5, 2, 1, 1, 0, 1
set neig, rese
set neig, vec, 1, number:1
set neig, vec, 2, number:2
set neig, vec, 3, number:3
set neig, vec, 4, number:4
set neig, vec, 5, number:5
set neig, dis, 0.5, 0.5, 0.5, 0.1, number:6
set neig, dis, 1.0, 0.0, 0.0, 0.1, number:7
show
corr occ, Au, Cu
eval res[0]
eval res[1]
eval res[2]
eval res[3]
eval res[4]
eval res[5]
eval res[6]
eval res[7]
corr occ, Cu, Au
eval res[0]
eval res[1]
eval res[2]
eval res[3]
eval res[4]
eval res[5]
eval res[6]
eval res[7]
exit
exit
exit
