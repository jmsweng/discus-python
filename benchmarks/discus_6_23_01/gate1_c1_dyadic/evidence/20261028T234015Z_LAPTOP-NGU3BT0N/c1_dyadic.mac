# Gate 1 pre-registered C1 run on a dyadic hkl grid (generated by c1_dyadic.py; do not edit)
discus
read
  stru C1_frozen.stru
eval n[1]
eval n[3]
fourier
  xray
  wvle moa1
  ll -0.15625,-0.15625,-0.15625
  lr 0.15625,-0.15625,-0.15625
  ul -0.15625,0.15625,-0.15625
  tl -0.15625,-0.15625,0.15625
  na 41
  no 41
  nt 41
  abs h
  ord k
  top l
  temp use
  disp off
  lots off
  set technique:turbo
  set aver,0.0
  show
  run
exit
output
  value int
  form nexus
  outf c1_dyadic_total.h5
  run
exit
fourier
  set aver,100.0
  show
  run
exit
output
  value int
  form nexus
  outf c1_dyadic_diffuse.h5
  run
exit
exit
exit
