# D MMC probe Cu sc 12^3 displaced
discus
seed 11,22,33,44,55,66,77,88
set parallel, useomp:off
read
  stru mc_in.stru
mmc
set vec, reset
set vec, 1, 1, 1, 1, 0, 0
set vec, 2, 1, 1, -1, 0, 0
set vec, 3, 1, 1, 0, 1, 0
set vec, 4, 1, 1, 0, -1, 0
set vec, 5, 1, 1, 0, 0, 1
set vec, 6, 1, 1, 0, 0, -1
set neig, rese
set neig, vec, 1, 2, 3, 4, 5, 6, number:1
set mode, 1.0, swdisp, all
set target, 1, cd, Cu, Cu, 0.3, 0.0, CORR, dir:[1.0,0.0,0.0]
set temp, 1.0
set cyc, 17280
set feed, 1728
set output, feed:on, final:on
show
run
exit
save mc_out.stru
exit
exit
