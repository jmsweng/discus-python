# D MMC probe r3b_occ_ener_cold (generated by make_inputs.py; do not edit)
discus
seed 11,22,33,44,55,66,77,88
set parallel, useomp:off
read
  stru cuau.stru
mmc
set vec, 1, 1, 1, 1, 0, 0
set vec, 2, 1, 1, -1, 0, 0
set vec, 3, 1, 1, 0, 1, 0
set vec, 4, 1, 1, 0, -1, 0
set vec, 5, 1, 1, 0, 0, 1
set vec, 6, 1, 1, 0, 0, -1
set neig, rese
set neig, vec, 1, 2, 3, 4, 5, 6, number:1
set mode, 1.0, swchem, all
set target, 1, corr, Cu, Au, 0.0, 0.5, ENER
set temp, 1.0
set cyc, 40960
set feed, 4096
show
run
exit
save r3b_occ_ener_cold_out.stru
exit
exit
