# Generated by discuspdf: 1D atomic PDF calculation (DISCUS v6.x)
discus
read
cell model.cll,5,5,5
powder
reset
xray
set axis,q
set calc,debye
set qmin,0.5
set qmax,6
set dq,0.01
set delta,0
set wvle,1.5406
run
exit
output
outf fq.dat
form powder, q
value F(Q)
run
outf result.pdf
form pdf, r, 0.0, 12, 0.02
value PDF
run
exit
exit
